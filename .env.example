# AdGuard Home Configuration
ADGUARD_URL=http://localhost:3000
ADGUARD_USERNAME=admin
ADGUARD_PASSWORD=your_password_here

# Server Configuration
# Change PORT if 8080 is already in use (e.g., 3001, 8081, etc.)
PORT=8080
NODE_ENV=production

# Source Location (Kuala Lumpur)
SOURCE_LAT=3.139
SOURCE_LNG=101.6869

# GeoIP API Configuration (Optional)
# Default: http://ip-api.com/json (45 req/min free tier, HTTP only).
# Plain HTTP exposes looked-up IPs on the network; the server logs a warning.
# Prefer an https:// provider if you have one.
# GEOIP_API_URL=http://ip-api.com/json
# GEOIP_API_TIMEOUT=5000
# GEOIP_MAX_RETRIES=2
# GEOIP_RETRY_DELAY=1000
# GEOIP_MAX_CACHE_SIZE=1000
# GEOIP_MAX_REQUESTS_PER_MINUTE=15
# GEOIP_MIN_REQUEST_DELAY=4000

# Performance Settings
MAX_CONCURRENT_ARCS=100
# Maximum simultaneous WebSocket clients (resource-exhaustion DoS guard)
MAX_WS_CONNECTIONS=50
# Maximum WebSocket clients per IP (0 = unlimited; raise behind a reverse proxy)
MAX_WS_CONNECTIONS_PER_IP=5
# Extra origins allowed to open the WebSocket, comma-separated (reverse proxy domain).
# Same-origin is always allowed; all other sites are rejected.
# ALLOWED_ORIGINS=https://dns.example.com
# Hostnames used to open the dashboard, comma-separated (IPs and localhost always work).
# Unknown hostnames get HTTP 421 to block DNS-rebinding attacks.
# ALLOWED_HOSTS=dashboard.lan,my-mac.local
# Reverse proxy IPs/CIDRs whose X-Forwarded-For is trusted (rate limiting uses the real client IP).
# Leave unset without a proxy. Use plain IPv4 CIDR, never "true" or "*".
# TRUST_PROXY=172.18.0.0/16
LOG_RETENTION_COUNT=10
# DNS polling interval (ms) - Higher values = less API rate limiting
# Recommended: 3000-5000ms to avoid API bursts
POLL_INTERVAL_MS=3000
STATS_INTERVAL_MS=5000
